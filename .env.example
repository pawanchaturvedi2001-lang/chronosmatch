# ==============================================================================
# ChronosMatch — Environment Configuration Example
# Copy this file to .env to configure local environment parameters
# ==============================================================================

# Django Secret Key (Set a random string for production deployments)
CHRONOS_SECRET_KEY=chronosmatch-insecure-dev-key-zero-copy-matching-engine-2026

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=127.0.0.1,localhost

# Local Server Host & Port
HOST=127.0.0.1
PORT=8000
